{
  "name": "bel-sekolah",
  "version": "1.0.0",
  "description": "Aplikasi Bel Sekolah Otomatis SMPN 8 Ciamis",
  "main": "src/main.js",
  "author": "SMPN 8 Ciamis",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.smpn8ciamis.belsekolah",
    "productName": "BelSekolah",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bel Sekolah",
      "artifactName": "BelSekolah-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BelSekolah-Portable-${version}.${ext}"
    }
  }
}